# CWP fiscal policy tab of the budget panel: central bank, currency, interest rate, inflation,
# monetary policy, money supply and foreign reserves (restored from Cold War Project master gui/budget_panel.gui)
@panel_width_minus_10 = 530			# used to be 450
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

types cwp_budget_fiscal {
	type cwp_budget_fiscal_content = flowcontainer {
		using = default_content_fade
		direction = vertical
		using = default_list_position
		spacing = 10

		default_header = {
			blockoverride "text" {
				text = "[concept_central_bank]"
			}
		}

		flowcontainer = {
			spacing = 10
			direction = vertical
			using = default_list_position

			widget = {
				size = { @panel_width_minus_10 1100 }
				parentanchor = hcenter

				flowcontainer = {
					margin = { 0 0 }
					direction = vertical
					spacing = 20
					flowcontainer = {
						direction = vertical
						margin_top = 10
						margin_bottom = 10
						widget = {
							size = { @panel_width_minus_10  1000 }
							button = { # Icon
								parentanchor = left|top
								position = { 20 5 }
								icon = {
									texture = "gfx/interface/icons/cwp_icons/central_bank.dds"
									tooltip = "[concept_central_bank]"
									size = { 150 150 }
									background = {
										using = simple_frame
										using = dropdown_background
									}
								}
							}
							button = { # Text
								parentanchor = right|top
								size = { 350 40 }
								raw_text = "[GetPlayer.GetAdjective] [concept_central_bank] | [GetPlayer.GetCustom('bank_credibility_loc')]"
								using = expand_button_bg_no_fade
								tooltipwidget = {
									bank_credibility_tooltip = {}
								}
								onclick = "[GetVariableSystem.Toggle('banks_panel')]"
							}
							# Info
							flowcontainer = {
								parentanchor = hcenter
								direction = vertical
								position = { 50 50 }
								spacing = 10
								flowcontainer = {
									direction = vertical
									spacing = 25
									textbox = {
										using = tooltip_above
										raw_text = "#t [concept_bank_independence]#!"
										using = fontsize_large
									}
									textbox = {
										using = tooltip_above
										raw_text = "#t [GetPlayer.GetCustom('bank_independence_loc')]#!"
										using = fontsize_large
									}
								}
								tooltip = "CENTRAL_BANK_CUSTOM_LOC"
								widget = {
									size = { 250 20 }
									divider_clean = {
										parentanchor = center
									}
								}
								flowcontainer = {
									direction = vertical
									spacing = 25
									textbox = {
										using = tooltip_above
										raw_text = "#T Currency#!"
										using = fontsize_large
									}
									textbox = {
										using = tooltip_above
										raw_text = "[GetPlayer.MakeScope.Var('cwp_currency').GetFlagName][GetPlayer.GetCustom('currency_text_loc')] | Denomination: [GetPlayer.MakeScope.ScriptValue('country_currency_denomination')|d]"
										using = fontsize_large
									}
									flowcontainer = {
										direction = horizontal
										spacing = 5
										button = {
											size = { 130 30 }
											using = expand_button_bg_no_fade
											raw_text = "Devalue"
											onclick = "[GetScriptedGui('devalue_currency').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
											enabled = "[GetScriptedGui('can_alter_currency').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											tooltip = "DEVALUE_CURRENCY_TOOLTIP"
										}
										button = {
											size = { 130 30 }
											using = expand_button_bg_no_fade
											raw_text = "Revalue"
											onclick = "[GetScriptedGui('revalue_currency').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
											enabled = "[GetScriptedGui('can_alter_currency').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											tooltip = "REVALUE_CURRENCY_TOOLTIP"
										}
									}


								}
								button = {
									size = { 260 30 }
									using = expand_button_bg_no_fade
									raw_text = "Redenominate"
									onclick = "[GetScriptedGui('redenominate_currency').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									enabled = "[GetScriptedGui('can_redenominate_currency').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									tooltip = "REDENOMINATE_CURRENCY_TOOLTIP"
								}
								widget = {
									size = { 250 20 }
									divider_clean = {
										parentanchor = center
									}
								}
							}
							flowcontainer = {
								position = { 0 250 }
								margin = { 10 10 }
								direction = vertical
								spacing = 10
								flowcontainer = { # 1.14: boxes cannot be direct children of a flowcontainer
									flowcontainer = {
										margin_top = 0
										direction = vertical
										spacing = 25
										textbox = {
											using = tooltip_above
											raw_text = "#T [concept_interest_rate]"
											using = fontsize_large
										}
										textbox = {
											using = tooltip_above
											text = "CURRENT_INTEREST_RATE"
											using = fontsize_large
										}
										widget = {
											size = { 250 20 }
											divider_clean = {
												parentanchor = center
											}
										}
									}
									flowcontainer = {
										direction = vertical
										spacing = 10
										flowcontainer = {
											margin_top = 10
											spacing = 10
											button = {
												size = { 70 30 }
												using = expand_button_bg_no_fade
												raw_text = "-"
												enabled = "[GetScriptedGui('can_set_interest_rates').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onclick = "[GetScriptedGui('lower_interest_rate').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
											}
											button = {
												size = { 70 30 }
												using = expand_button_bg_no_fade
												text = "[SelectLocalization(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('interest_rate'), GetPlayer.MakeScope.ScriptValue('interest_rate_gui')), 'CURRENT_INTEREST_RATE', 'TARGET_INTEREST_RATE')]"
												enabled = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('interest_rate'), GetPlayer.MakeScope.ScriptValue('interest_rate_gui')))]"
												onclick = "[GetScriptedGui('submit_interest_rate').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
											}
											button = {
												size = { 70 30 }
												using = expand_button_bg_no_fade
												raw_text = "+"
												enabled = "[GetScriptedGui('can_set_interest_rates').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												onclick = "[GetScriptedGui('raise_interest_rate').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
											}
											tooltip = "ALTER_INTEREST_RATES"
										}
										widget = {
											size = { 250 20 }
											divider_clean = {
												parentanchor = center
											}
										}
									}
								}
								flowcontainer = { # 1.14: boxes cannot be direct children of a flowcontainer
									flowcontainer = {
										margin_top = 10
										direction = vertical
										spacing = 25
										textbox = {
											using = tooltip_above
											raw_text = "#T [concept_inflation_rate]"
											using = fontsize_large
										}
										textbox = {
											raw_text = "#v [GetPlayer.MakeScope.ScriptValue('inflation_value')|d%]#! | [GetPlayer.MakeScope.ScriptValue('inflation_growth')|-Od%] per month"
											using = fontsize_large
										}
										tooltipwidget = {
											inflation_tooltip = {}
										}
										widget = {
											size = { 505 20 }
											divider_clean = {
												parentanchor = center
											}
										}
									}
								}


							}
							flowcontainer = {
								parentanchor = hcenter
								direction = vertical
								position = { 0 470 }
								margin = { 10 10 }
								spacing = 10
								flowcontainer = {
									direction = vertical
									spacing = 25
									textbox = {
										margin_left = 15
										using = tooltip_above
										raw_text = "#t [concept_monetary_policy]#!"
										using = fontsize_large
									}
									flowcontainer = {
										spacing = 10
										button = {
											size = { 160 30 }
											using = expand_button_bg_no_fade
											raw_text = "[concept_contractionary_monetary_policy]"
											onclick = "[GetScriptedGui('set_contractionary_monetary_policy').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
											enabled = "[GetScriptedGui('can_set_contractionary').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
										button = {
											size = { 160 30 }
											using = expand_button_bg_no_fade
											raw_text = "[concept_stable_monetary_policy]"
											onclick = "[GetScriptedGui('set_stable_monetary_policy').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
											enabled = "[GetScriptedGui('can_set_stable').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
										button = {
											size = { 160 30 }
											using = expand_button_bg_no_fade
											raw_text = "[concept_expansionary_monetary_policy]"
											onclick = "[GetScriptedGui('set_expansionary_monetary_policy').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
											enabled = "[GetScriptedGui('can_set_expansionary').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}
								}
								widget = {
									size = { 500 20 }
									divider_clean = {
										parentanchor = center
									}
								}
								flowcontainer = {
									margin = { 10 10 }
									direction = vertical
									spacing = 25
									textbox = {
										using = tooltip_above
										raw_text = "#T [concept_money_supply]#!  [GetPlayer.MakeScope.ScriptValue('money_supply_percentage')|d%] | [GetPlayer.MakeScope.ScriptValue('money_supply_growth_percentage')|d%] per month"
										using = fontsize_large
									}
									double_direction_progressbar_gold = {
										size = { 500 25 }
										blockoverride "negative_min_max_values" {
											min = "[Negate_float(FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('money_supply_max')))]"
											max = 0
										}

										blockoverride "positive_min_max_values" {
											min = 0
											max = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('money_supply_max'))]"
										}

										blockoverride "value_left" {
											value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('money_supply'))]"
										}
										blockoverride "value_right" {
											value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('money_supply'))]"
										}
									}
									container = {
										parentanchor = hcenter
										minimumsize = { 100 30 }
										textbox = {
											margin_bottom = 10
											parentanchor = center
											align = center
											using = tooltip_above
											raw_text = "[GetPlayer.MakeScope.ScriptValue('money_supply_max')|vd] Capacity | [GetPlayer.MakeScope.ScriptValue('money_supply_growth')|+0d] per month"
											using = fontsize_large

										}

									}

									tooltipwidget = {
										money_supply_tooltip = {}
									}
									background = {
										using = dropdown_background
									}
								}
								flowcontainer = {
									margin = { 10 10 }
									direction = vertical
									spacing = 25
									textbox = {
										margin_top = 90
										using = tooltip_above
										raw_text = "#T Foreign Reserves#! | [GetPlayer.MakeScope.ScriptValue('foreign_reserves_value')|+0d] > #p [GetPlayer.MakeScope.ScriptValue('foreign_reserves_conversion')|+0d]#!"
										using = fontsize_large
									}
									flowcontainer = {
										parentanchor = right
										#margin_top = -30
										button = {
											size = { 180 40 }
											using = expand_button_bg_no_fade
											raw_text = "Sell Foreign Reserves"
											onclick = "[GetScriptedGui('sell_foreign_reserves').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
											enabled = "[GetScriptedGui('can_sell_currency').IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											tooltip = "FOREIGN_RESERVES_SELL_TOOLTIP"
										}
									}
									gold_progressbar_horizontal = {
										size = { 500 25 }
										blockoverride "values" {
											value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('foreign_reserves_value'))]"
											max = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('foreign_reserves_max'))]"
										}
										tooltipwidget = {
											foreign_reserves_tooltip = {}
										}
									}
									background = {
										using = dropdown_background
									}
								}
								widget = {
									size = { 500 20 }
									divider_clean = {
										parentanchor = center
									}
								}
								flowcontainer = {
									margin = { 10 10 }
									direction = vertical
									spacing = 25
									textbox = {
										using = tooltip_above
										raw_text = "#T Investor Confidence#!"
										using = fontsize_large
									}
									textbox = {
										using = tooltip_above
										raw_text = "[GetPlayer.MakeScope.ScriptValue('investor_confidence')|+1%] due to [GetPlayer.GetCustom('bank_credibility_loc')] [concept_central_bank] credibility"
										using = fontsize_large
									}
								}
							}
							######## Bottom
							background = {
								texture = "gfx/interface/illustrations/government/government_illustration.dds"
								alpha = 0.2
								fittype = centercrop
								using = frame_small_mask
								modify_texture = {
									texture = "gfx/interface/masks/fade_horizontal_center.dds"
									spriteType = Corneredstretched
									spriteborder = { 100 200 }
									blend_mode = alphamultiply
								}
							}
						}
						background = {
							using = dropdown_background
						}
					}
				}
			}

		}
	}
}
